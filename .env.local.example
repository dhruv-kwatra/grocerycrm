# platform/retailcrm/.env.local — copy to `.env.local` and fill in.
# Standalone Retail CRM frontend. Holds NO database credentials — login is
# verified by the backend (POST /api/retail/auth/verify). It only needs the
# backend URL + the shared API secret.

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Long random string. Can differ from the portal's (this app issues its own
# session cookie on its own host). openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Set to the retail app's HTTPS origin in production (turns the session cookie
# Secure back on). Leave UNSET for http/IP access.
# AUTH_URL=https://retail.your-domain

# ── Backend API (NestJS, platform/backend) ───────────────────────────────────
API_BASE_URL=http://127.0.0.1:4400
# MUST be identical to API_JWT_SECRET in platform/backend/.env (and the portal).
API_JWT_SECRET=change-me-shared-with-frontend

# ── Google login (optional) ──────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
